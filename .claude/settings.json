{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*)", "Read(./**/.env*)"]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
                        "timeout": 300
                    }
                ]
            }
        ]
    }
}
